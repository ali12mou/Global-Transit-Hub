# Copier vers .env sur le serveur (ne pas committer les secrets).
NODE_ENV=production
FRONTEND_ORIGIN=https://globaltransit-transportservice.com,https://www.globaltransit-transportservice.com

PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/global
JWT_SECRET=remplacer-par-une-chaine-longue-et-aleatoire

# Optionnel : seed admin au premier démarrage
# AUTO_SEED_ADMIN=1
# ADMIN_EMAIL=...
# ADMIN_PASSWORD=...
